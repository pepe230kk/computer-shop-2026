# ==============================================================================
# KONFIGURACJA ŚRODOWISKA (Tabela 3.1 - Laboratorium 10)
# ==============================================================================
# UWAGA: Żadna z tych zmiennych NIE może posiadać prefiksu NEXT_PUBLIC_.
# Rzeczywiste sekrety należy umieszczać wyłącznie w magazynie sekretów Vercel
# (Project Settings -> Environment Variables) lub w lokalnym pliku .env (ignorowanym przez Git).
# ==============================================================================

# 1. Połączenie aplikacji ze zdalnym PostgreSQL (np. Neon, Supabase)
#    Adres i parametry puli (sslmode=require, pgbouncer, direct connection do migracji).
#    Dla środowiska lokalnego: postgresql://shop_user:shop_password@127.0.0.1:5432/computer_shop?schema=public
#    Dla produkcji: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@remote-db-host.neon.tech/computer_shop?sslmode=require"

# 2. Stały adres bazowy Production (np. https://sklep-demo.vercel.app lub własna domena)
#    Używany przez Better Auth do generowania adresów powrotnych OAuth i walidacji cookie.
BETTER_AUTH_URL="https://computer-shop-2026kl.vercel.app"

# 3. Odrębny, kryptograficznie bezpieczny losowy sekret środowiska (co najmniej 32 znaki)
#    Wygeneruj np. poleceniem: openssl rand -base64 32
BETTER_AUTH_SECRET="e9b28a1c4d7f0e3a5b8c1d2e4f6a8b0c2d4e6f8a0b2c4d6e8f0a2b4c6d8e0f2a"

# 4. Dane osobnej produkcyjnej OAuth App GitHub
#    Zarejestrowana na GitHub z Authorization callback URL: https://computer-shop-2026kl.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID="github_oauth_production_client_id"
GITHUB_CLIENT_SECRET="github_oauth_production_client_secret"

# 5. Opcjonalna konfiguracja środowiska testowego (Rozszerzenie 1)
# TEST_DATABASE_URL="postgresql://user:password@remote-db-host.neon.tech/computer_shop_test?sslmode=require"
# TEST_BETTER_AUTH_URL="https://computer-shop-preview.vercel.app"

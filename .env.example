# Konfiguracja bazy danych PostgreSQL dla Prisma 7
DATABASE_URL="postgresql://shop_user:shop_password@127.0.0.1:5432/computer_shop?schema=public"

# Konfiguracja Better Auth (Lab 09)
BETTER_AUTH_SECRET="your-at-least-32-chars-long-random-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth App credentials
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  name     String
  products Product[]
}

model Product {
  id          Int      @id
  code        String   @unique
  name        String
  description String
  image       String
  price       Int
  amount      Int
  date        DateTime @db.Timestamptz(3)
  nameSortKey String   @db.Text

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, amount])
  @@index([nameSortKey])
  @@index([date])
}
